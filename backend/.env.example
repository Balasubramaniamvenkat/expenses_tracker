# ===========================================
# AI Model API Keys - Family Finance Tracker
# ===========================================
# Copy this file to .env and add your API keys
# Only models with valid keys will be available
# ===========================================

# Google Gemini (Recommended - Free tier available)
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (GPT models)
# Get key from: https://platform.openai.com/api-keys
# Requires: pip install langchain-openai
OPENAI_API_KEY=

# Anthropic (Claude)
# Get key from: https://console.anthropic.com/
# Requires: pip install langchain-anthropic
ANTHROPIC_API_KEY=

# Groq (Fast inference - Free tier)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# ===========================================
# Model Selection Defaults
# ===========================================
# Default model to use when user hasn't selected one
DEFAULT_AI_MODEL=gemini-2.5-flash
